# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://gsm:gsm_password@localhost:5432/gsm_otp

# ── Modems ───────────────────────────────────────────────────────────────
MODEMS_CONFIG=./config/modems.yaml

# ── Security ─────────────────────────────────────────────────────────────
# Enable API key auth for /api/* routes.
# Still public when auth is on: dashboard assets, /api/health,
# /api/modems* (fleet ops), and /api/messages (inbox).
# Still require key: /api/wait-otp, /api/otp/*, webhooks automation.
API_AUTH_ENABLED=false
# Comma-separated list of accepted keys. Send via header: x-api-key: <key>
API_KEYS=
# Comma-separated allowed origins, or * for all.
CORS_ORIGINS=*

# ── Rate limiting (per client) ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── OTP webhook (optional) ───────────────────────────────────────────────
# If set, every extracted OTP is POSTed as JSON to this URL.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TIMEOUT_MS=5000

# ── Discord webhook notification (optional) ──────────────────────────────
# If set, every extracted OTP is posted to this Discord channel webhook.
# Create one: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT_MS=5000

# ── API docs ─────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
